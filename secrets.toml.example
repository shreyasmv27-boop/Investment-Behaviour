# Copy these into the app's Secrets box on Streamlit Community Cloud (Settings > Secrets).
# Do not commit a real secrets.toml to GitHub.

form_url = "https://docs.google.com/forms/d/e/YOUR_FORM_ID/viewform"
form_id_field = "entry.1234567890"   # the prefill field for "Respondent ID" (see README)

sheet_id = "YOUR_GOOGLE_SHEET_ID"    # the long ID in the sheet's URL

[gcp_service_account]
type = "service_account"
project_id = "..."
private_key_id = "..."
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "...@....iam.gserviceaccount.com"
client_id = "..."
token_uri = "https://oauth2.googleapis.com/token"
